# Segredos e configuração local
.env
.env.test
.env.*.local

# Arquivos gerados (imagens, PDFs, logs, cache)
storage/*
!storage/.gitkeep
!storage/.htaccess
!storage/public/
storage/public/*
!storage/public/.gitkeep
!storage/public/.htaccess
!storage/logs/
storage/logs/*
!storage/logs/.gitkeep
!storage/cache/
storage/cache/*
!storage/cache/.gitkeep

# Partes do vendor/ que não são usadas em produção (fontes do mPDF: usamos
# templates/fonts; testes das bibliotecas). O restante do vendor/ é versionado.
vendor/mpdf/mpdf/ttfonts/
vendor/mpdf/mpdf/tests/
vendor/mpdf/mpdf/tmp/
vendor/setasign/fpdi/tests/
vendor/setasign/fpdi/local-tests/

# Ferramentas e sistema
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
