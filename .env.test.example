# .env.test.example — copie para .env.test para rodar `php tests/run.php`
# contra um banco SEPARADO do de produção. Se .env.test não existir,
# os testes usam o .env comum.
APP_NAME="Materiais Visuais CECAPE (testes)"
APP_ENV=test
APP_DEBUG=1
BASE_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=materiais_test
DB_USER=materiais
DB_PASS=
STORAGE_PATH=
AI_MOCK=1
GEMINI_API_KEY=
OPENAI_API_KEY=
