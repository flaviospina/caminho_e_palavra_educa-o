# .env.example — copie para .env (fora da pasta public/) e preencha.
# Nunca versione o arquivo .env. Chaves e senhas ficam só aqui.

# ── Aplicação ────────────────────────────────────────────────
APP_NAME="Materiais Visuais CECAPE"
# production | development | test
APP_ENV=production
# 1 mostra erros detalhados no navegador (só em desenvolvimento)
APP_DEBUG=0
# URL pública sem barra final. Em subpasta do HostGator: https://cecapescs.com.br/materiais
# No cecape-server (domínio próprio): https://materiais.cecapescs.com.br
BASE_URL=
APP_TIMEZONE=America/Sao_Paulo

# ── Banco de dados (MySQL 8, utf8mb4) ────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=materiais
DB_USER=materiais
DB_PASS=

# ── Armazenamento (fora de public/; vazio = pasta storage/ do projeto) ──
STORAGE_PATH=

# ── Inteligência artificial ──────────────────────────────────
# 1 = modo simulado: nenhum crédito é gasto; motores devolvem exemplos.
AI_MOCK=1
# Chaves (deixe vazio enquanto AI_MOCK=1)
GEMINI_API_KEY=
OPENAI_API_KEY=
# Motores de imagem ativos (separados por vírgula): gemini, openai
IMAGE_ENGINES=gemini,openai
# Modelos de imagem (IDs confirmados em 16/10/2026 — ver PROGRESSO.md)
#   Gemini: gemini-3-pro-image (padrão) | gemini-3.1-flash-image | gemini-3.1-flash-lite-image
#   OpenAI: gpt-image-2.5-flare (padrão, rápido) | gpt-image-2.5-sunburst (qualidade)
GEMINI_IMAGE_MODEL=gemini-3-pro-image
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Motor usado na GERAÇÃO das páginas (fila): gemini | openai
IMAGE_ENGINE=gemini
# Conferência automática das páginas por um modelo com visão (1 = ligada)
VERIFY_ENABLED=1
GEMINI_VISION_MODEL=gemini-3.8-flash
# Worker: segundos máximos por execução em lote (cron) e minutos para considerar um job órfão
WORKER_MAX_SECONDS=50
WORKER_STALE_MINUTES=10
# Motor de TEXTO (conteúdo em JSON): gemini (padrão) | mock
TEXT_ENGINE=gemini
GEMINI_TEXT_MODEL=gemini-3.8-flash
TEXT_TIMEOUT=120
# Qualidade: low | medium | high (OpenAI) — no Gemini vira 1K | 2K | 2K
IMAGE_QUALITY=high
# Tempo limite de cada chamada (s), novas tentativas e espera base entre elas (s)
AI_TIMEOUT=360
AI_RETRIES=2
AI_BACKOFF=5
# ── E-mail (recuperação de senha, avisos) ───────────────────
# mail = função mail() do PHP (HostGator/HestiaCP) · log = grava em storage/logs/mail.log
MAIL_DRIVER=mail
MAIL_FROM=nao-responda@cecapescs.com.br
MAIL_FROM_NAME="Materiais Visuais CECAPE"

# ── Termo de uso ────────────────────────────────────────────
# Versão vigente (docs/TERMO-DE-USO.md). Mudar a versão obriga novo aceite.
TERM_VERSION=2026-10
